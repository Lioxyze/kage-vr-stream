<Window x:Class="KageVR.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KAGÉ VR Stream" Width="1080" Height="720" MinWidth="860" MinHeight="600"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen" Icon="kage.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="6,0,0,12">
            <Border Width="6" Background="{StaticResource Violet}" CornerRadius="3" Margin="0,4,12,4"/>
            <StackPanel>
                <TextBlock Text="KAGÉ VR Stream" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Streaming PCVR sans fil vers Meta Quest" Foreground="{StaticResource Dim}" FontSize="13"/>
            </StackPanel>
        </StackPanel>

        <!-- Status cards -->
        <UniformGrid Grid.Row="1" Columns="4">
            <Border Style="{StaticResource CardStyle}"><StackPanel>
                <TextBlock Text="SERVICE" Foreground="{StaticResource Dim}" FontSize="11"/>
                <TextBlock x:Name="ServiceState" Text="Arrêté" FontSize="18" FontWeight="SemiBold"/>
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel>
                <TextBlock Text="CASQUE" Foreground="{StaticResource Dim}" FontSize="11"/>
                <TextBlock x:Name="HeadsetState" Text="Non connecté" FontSize="18" FontWeight="SemiBold"/>
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel>
                <TextBlock Text="STEAMVR" Foreground="{StaticResource Dim}" FontSize="11"/>
                <TextBlock x:Name="SteamVrState" Text="—" FontSize="18" FontWeight="SemiBold"/>
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel>
                <TextBlock Text="PILOTE STEAMVR" Foreground="{StaticResource Dim}" FontSize="11"/>
                <TextBlock x:Name="DriverState" Text="—" FontSize="18" FontWeight="SemiBold"/>
            </StackPanel></Border>
        </UniformGrid>

        <!-- Actions -->
        <WrapPanel Grid.Row="2" Margin="0,4">
            <Button x:Name="ServiceButton" Style="{StaticResource Primary}" Content="Démarrer le service" Click="OnServiceClick"/>
            <Button Content="Lancer SteamVR" Click="OnLaunchSteamVr"/>
            <Button x:Name="DriverButton" Content="Installer le pilote SteamVR" Click="OnDriverClick"/>
            <Button Content="Lancer le diagnostic" Click="OnDiagnostic"/>
            <Button Content="Oublier les casques appairés" Click="OnForgetPaired"/>
        </WrapPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="3" Margin="6,8,6,0" Background="Transparent" BorderBrush="{StaticResource Border}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="t" Padding="16,8" Margin="0,0,4,0" CornerRadius="8,8,0,0" Background="#16141E">
                                    <ContentPresenter ContentSource="Header" TextElement.Foreground="#ECEBF4"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="t" Property="Background" Value="#3A2A66"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Tableau de bord">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid x:Name="Metrics" Columns="4" Margin="0,8"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Full body (Rift CV1)">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10">
                    <TextBlock TextWrapping="Wrap" Foreground="#B9B7C9" Margin="0,0,0,10"
                               Text="Les manettes Touch du Rift CV1 deviennent des trackers SteamVR (pied gauche, pied droit, bassin = 3e manette déclarée comme « objet VR » dans Meta Horizon Link). Remplace OculusTouchLink, Space Calibrator et ODTKRA. Fonctionne avec KAGÉ ou Virtual Desktop : garder KageVR ouvert (il lit le Rift)."/>
                    <CheckBox x:Name="FullBodyCheck" Foreground="#ECEBF4" Content="Activer le full body (prise en compte au prochain lancement de SteamVR)" Click="OnFullBodyToggle" Margin="0,4"/>
                    <CheckBox x:Name="KeepAwakeCheck" Foreground="#ECEBF4" Content="Garder le Rift éveillé et réduire son rendu au minimum (moins de charge GPU)" Click="OnKeepAwakeToggle" Margin="0,4"/>
                    <WrapPanel Margin="0,8">
                        <Button Content="1. Lancer Meta Horizon Link" Click="OnLaunchOculus"/>
                        <Button Style="{StaticResource Primary}" Content="2. Calibrer" Click="OnCalibrate"/>
                        <Button Content="Manettes Touch : jamais en veille" Click="OnTouchNoSleep"/>
                    </WrapPanel>
                    <TextBlock Text="ÉTAT" FontSize="11" Foreground="#8A879C" Margin="0,8,0,2"/>
                    <TextBlock x:Name="FullBodyStatus" TextWrapping="Wrap" Foreground="#5CE1E6" FontSize="15" Text="Non disponible"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#8A879C" Margin="0,12,0,0"
                               Text="Calibration : casque Quest sur la tête et SteamVR lancé, colle la manette DROITE du Rift contre la manette DROITE du Quest (bien serrées dans la main), clique « Calibrer », puis fais-les tourner dans tous les sens pendant 15 s. À refaire seulement si les capteurs du Rift ou la zone de jeu du Quest changent."/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Diagnostic">
                <TextBox x:Name="DiagnosticText" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                         Background="#0F0E15" Foreground="#ECEBF4" BorderThickness="0" Padding="10"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         Text="Cliquer sur « Lancer le diagnostic » pour analyser le GPU, les encodeurs, SteamVR et le réseau."/>
            </TabItem>
            <TabItem Header="Journal">
                <TextBox x:Name="LogText" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         Background="#0F0E15" Foreground="#B9B7C9" BorderThickness="0" Padding="10"
                         VerticalScrollBarVisibility="Auto"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
